# Comma-separated browser origins permitted to call this API.
# Example: ALLOWED_ORIGINS=https://your-app.base44.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
PORT=8000
DATABASE_PATH=twin.sqlite3

# Authentication: keep development locally while prototyping. Set AUTH_MODE=clerk
# only after configuring the Clerk issuer and JWKS URL in a deployed environment.
AUTH_MODE=development
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=

# Optional public-demo-Twin chat. Keep this key server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional Fish Audio TTS for previously generated public Twin answers only.
# Use an authorized synthetic voice; never configure a real person's voice without consent.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro
# Optional fallback voice for all demo Twins. Leave blank to use Fish Audio's default voice.
FISH_AUDIO_REFERENCE_ID=
# Optional distinct synthetic voice reference IDs per Twin.
FISH_AUDIO_REFERENCE_ID_ALEX_DEMO=
FISH_AUDIO_REFERENCE_ID_MAYA_DEMO=
FISH_AUDIO_REFERENCE_ID_JACK_DEMO=
FISH_AUDIO_REFERENCE_ID_LENA_DEMO=
FISH_AUDIO_REFERENCE_ID_DANIEL_DEMO=
FISH_AUDIO_REFERENCE_ID_SOFIA_DEMO=
