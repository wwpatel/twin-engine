ANTHROPIC_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
DAYTONA_API_KEY=
DAYTONA_API_URL=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Private Twins backend (mounted at /private); all optional ---
# DEMO_AUTH=1 lets /private accept an "X-Demo-User: <id>" header as the signed-in user. Demo only; leave unset otherwise.
DEMO_AUTH=
# Defaults to clerk (token verification) when unset. Do not set to "development" on a deployed service.
AUTH_MODE=
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=
# Defaults to a SQLite file in the system temp directory.
DATABASE_PATH=
# Voice (503 with a clear message when FISH_AUDIO_API_KEY is unset)
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_REFERENCE_ID_ALEX_DEMO=
FISH_AUDIO_REFERENCE_ID_MAYA_DEMO=
FISH_AUDIO_REFERENCE_ID_JACK_DEMO=
FISH_AUDIO_REFERENCE_ID_LENA_DEMO=
FISH_AUDIO_REFERENCE_ID_DANIEL_DEMO=
FISH_AUDIO_REFERENCE_ID_SOFIA_DEMO=
# PORT is read by the Docker CMD (default 8000). ALLOWED_ORIGINS is ignored: CORS allows all origins.
PORT=
